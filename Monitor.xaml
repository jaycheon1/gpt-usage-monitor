<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="GPT Usage Monitor" Width="740" Height="820" MinWidth="590" MinHeight="540" Background="#10151F" Foreground="#EAF0F8" FontFamily="Malgun Gothic" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E7EDF6"/><Setter Property="Foreground" Value="#152238"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="ProgressBar"><Setter Property="Height" Value="12"/><Setter Property="Background" Value="#303B4B"/><Setter Property="Foreground" Value="#7DE0C4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/></Style>
</Window.Resources>
<ScrollViewer Background="#10151F" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<StackPanel Margin="24">
 <TextBlock Text="USAGE MONITOR / BETA 1.2 · 비공식 도구" Foreground="#7DE0C4" FontSize="12"/>
 <TextBlock Text="얼마나 더 사용할 수 있을까?" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,5"/>
 <TextBlock Text="로그인된 Codex 계정의 잔여 한도와 초기화 시간을 확인합니다." Foreground="#ACB9CD"/>
 <WrapPanel Margin="0,14,0,10" VerticalAlignment="Center">
  <TextBlock Text="한도 종류  " VerticalAlignment="Center"/>
  <ComboBox x:Name="Bucket" MinWidth="155" Margin="0,0,16,0"/>
  <CheckBox x:Name="Pin" Content="항상 위에" Foreground="#D8E2F1" VerticalAlignment="Center"/>
  <Button x:Name="Locate" Content="Codex 위치 선택" Margin="12,0,0,0" Padding="8,4"/>
 </WrapPanel>
 <Border Background="#1C2937" Padding="12" CornerRadius="8"><TextBlock x:Name="Status" Text="계정 연결 중…" Foreground="#7DE0C4"/></Border>
 <Grid Margin="0,16,0,0">
 <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="#1B2331" Padding="16" CornerRadius="12"><StackPanel>
  <TextBlock x:Name="PrimaryTitle" Text="단기 한도" Foreground="#ACB9CD"/>
  <TextBlock x:Name="PrimaryValue" Text="—" FontSize="44" FontWeight="SemiBold" Margin="0,9"/>
  <ProgressBar x:Name="PrimaryBar" AutomationProperties.Name="단기 잔여 한도"/>
  <TextBlock x:Name="PrimaryUsed" Text="조회 대기" Margin="0,9,0,16" Foreground="#ACB9CD"/>
  <TextBlock Text="초기화까지" Foreground="#ACB9CD"/>
  <TextBlock x:Name="PrimaryCountdown" Text="—" FontSize="19" Margin="0,5"/>
  <ProgressBar x:Name="PrimaryTime" Height="4" Foreground="#91ACFF" AutomationProperties.Name="단기 한도 기간 경과율"/>
  <TextBlock x:Name="PrimaryReset" FontSize="12" Foreground="#ACB9CD" Margin="0,9,0,0"/>
 </StackPanel></Border>
 <Border Grid.Column="2" Background="#1B2331" Padding="16" CornerRadius="12"><StackPanel>
  <TextBlock x:Name="SecondaryTitle" Text="주간 한도" Foreground="#ACB9CD"/>
  <TextBlock x:Name="SecondaryValue" Text="—" FontSize="44" FontWeight="SemiBold" Margin="0,9"/>
  <ProgressBar x:Name="SecondaryBar" AutomationProperties.Name="장기 잔여 한도"/>
  <TextBlock x:Name="SecondaryUsed" Text="조회 대기" Margin="0,9,0,16" Foreground="#ACB9CD"/>
  <TextBlock Text="초기화까지" Foreground="#ACB9CD"/>
  <TextBlock x:Name="SecondaryCountdown" Text="—" FontSize="19" Margin="0,5"/>
  <ProgressBar x:Name="SecondaryTime" Height="4" Foreground="#91ACFF" AutomationProperties.Name="장기 한도 기간 경과율"/>
  <TextBlock x:Name="SecondaryReset" FontSize="12" Foreground="#ACB9CD" Margin="0,9,0,0"/>
 </StackPanel></Border>
 </Grid>
 <TextBlock Text="초기화 대기 중 · 보라색 막대는 시간 경과이며 충전량이 아닙니다." Foreground="#ACB9CD" FontSize="12" Margin="0,10,0,12"/>
 <Border Background="#1B2331" Padding="14" CornerRadius="12"><StackPanel>
  <TextBlock Text="사용 기록 및 크레딧" FontSize="16"/>
 <TextBlock x:Name="Tokens" Text="누적 토큰 조회 중…" FontSize="21" Margin="0,8,0,5"/>
  <TextBlock x:Name="TokenDate" Foreground="#ACB9CD" FontSize="12"/>
  <TextBlock x:Name="Credits" Text="추가 크레딧 조회 중…" Margin="0,12,0,0"/>
  <TextBlock x:Name="ResetCredits" Foreground="#ACB9CD" Margin="0,5,0,0"/>
 </StackPanel></Border>
 <WrapPanel Margin="0,14,0,10">
  <Button x:Name="Refresh" Content="지금 새로고침"/>
  <Button x:Name="Pause" Content="자동 조회 일시정지"/>
 </WrapPanel>
 <TextBlock x:Name="Updated" Text="아직 조회되지 않았습니다." Foreground="#ACB9CD" FontSize="12"/>
 <TextBlock x:Name="Next" Foreground="#ACB9CD" FontSize="12" Margin="0,4,0,0"/>
 <TextBlock Text="15분마다 계정 조회 · 매초 카운트다운 · 한국 시간&#10;이 프로그램은 AI 답변을 생성하지 않습니다. 잔여 한도 %는 토큰 잔액이 아닙니다." Foreground="#ACB9CD" FontSize="12" Margin="0,10,0,0"/>
</StackPanel>
</ScrollViewer>
</Window>
